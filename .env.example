# Public origin, no trailing slash — canonical URLs, Open Graph, sitemap.
NEXT_PUBLIC_SITE_URL=https://ebtb.hu

# WooCommerce store origin, no trailing slash. Products (with photos) are fetched from here and checkout hands off to it.
# Required. Local store: Paymenthandling/README.md. See also docs/woocommerce-handoff.md
NEXT_PUBLIC_WOO_URL=
# Optional: the store origin as the Next.js *server* reaches it (private network address), if different from the public one.
WOO_API_URL=

# Shared with WordPress (EBTB_REVALIDATE_SECRET): product edits in the admin refresh the site via POST /api/revalidate.
REVALIDATE_SECRET=

# eMAG storefront link. Empty = eMAG button hidden.
NEXT_PUBLIC_EMAG_URL=

# Form delivery: every newsletter/contact submission is POSTed here as JSON (Make, Zapier, n8n, a WP endpoint…).
# Empty in production = forms answer 503 instead of dropping messages.
FORM_WEBHOOK_URL=

# Cloudflare Turnstile (dash.cloudflare.com → Turnstile). Both empty = no captcha.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
